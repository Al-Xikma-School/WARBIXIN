function normalizePhone(raw){
  if(raw===undefined || raw===null || raw==='') return '';
  let digits = String(raw).trim().replace(/[^0-9]/g,'');
  if(!digits) return '';
  if(digits.length === 7){ digits = '90' + digits; } // lambarka aan lahayn furaha (7 lambar) waxaa lagu daraa 90
  return digits;
}
