function setRating(idx, itemId, value){
  document.getElementById(`insp-${idx}-${itemId}`).value = value;
  ['good','average','weak'].forEach(v=>{
    document.getElementById(`btn-${idx}-${itemId}-${v}`).classList.toggle('active', v===value);
  });
  updateRatingProgress(idx);
}
function updateRatingProgress(idx){
  const rated = INSPECTION_ITEMS.filter(it=> document.getElementById(`insp-${idx}-${it.id}`).value).length;
  const total = INSPECTION_ITEMS.length;
  const fill = document.getElementById(`rating-progress-${idx}`);
  const label = document.getElementById(`rating-progress-label-${idx}`);
  if(fill) fill.style.width = Math.round(rated/total*100) + '%';
  if(label) label.textContent = `${rated}/${total} qodob la qiimeeyay`;
}
function saveInspection(){
  if(!currentInspection) return;
  const {teacherId, teacherName, fasal, maadooyinka} = currentInspection;
  for(let idx=0; idx<maadooyinka.length; idx++){
    const incomplete = INSPECTION_ITEMS.some(it=> !document.getElementById(`insp-${idx}-${it.id}`).value);
    if(incomplete){
      toast(`Fadlan qiimee dhammaan qodobada "${maadooyinka[idx]}" ka hor intaadan kaydin.`);
      return;
    }
  }
  const subjects = maadooyinka.map((maadada, idx)=>{
    const items = {};
    INSPECTION_ITEMS.forEach(it=>{ items[it.id] = document.getElementById(`insp-${idx}-${it.id}`).value; });
    return {maadada, items, notes: (document.getElementById(`insp-notes-${idx}`).value || '').trim()};
  });
  const key = db.child('inspections/'+teacherId).push().key;
  db.child('inspections/'+teacherId+'/'+key).set({teacherName, fasal, date: Date.now(), subjects}).then(()=>{
    toast('Taftiishka waa la kaydiyay.');
    document.getElementById('insp-form-area').innerHTML = '';
    document.getElementById('insp-maadada1').value = '';
    document.getElementById('insp-maadada2').value = '';
    document.getElementById('insp-maadada3').value = '';
    document.getElementById('insp-teacher').value = '';
    document.getElementById('insp-fasal').value = '';
    currentInspection = null;
    renderInspectionRanking();
    renderInspectionMatrix();
  });
}
function buildTeacherInspectionMessage(teacherName, subjects){
  let totalItems = 0, totalScore = 0;
  const blocks = (subjects || []).map(s=>{
    const good = INSPECTION_ITEMS.filter(it=>s.items && s.items[it.id]==='good').map(it=>it.label);
    const average = INSPECTION_ITEMS.filter(it=>s.items && s.items[it.id]==='average').map(it=>it.label);
    const weak = INSPECTION_ITEMS.filter(it=>s.items && s.items[it.id]==='weak').map(it=>it.label);
    INSPECTION_ITEMS.forEach(it=>{
      totalItems++;
      totalScore += RATING_WEIGHTS[s.items && s.items[it.id]] || 0;
    });
    let block = `📘 *${s.maadada}*\n`;
    if(good.length){
      block += `✅ Waxyaabaha aad ku fiican tahay:\n`;
      block += good.map(l=>`   • ${l}`).join('\n') + '\n';
    }
    if(average.length){
      block += `🌗 Waxyaabaha dhexdhexaadka ah:\n`;
      block += average.map(l=>`   • ${l}`).join('\n') + '\n';
    }
    if(weak.length){
      block += `🌱 Waxyaabaha aan xoojin u baahan nahay:\n`;
      block += weak.map(l=>`   • ${l}`).join('\n') + '\n';
    }
    if(s.notes) block += `📝 Fiiro gaar ah: ${s.notes}\n`;
    return block;
  }).join('\n');
  const pct = totalItems ? Math.round(totalScore/totalItems*100) : 0;
  return `Assalaamu Calaykum Warahmatullaahi Wabarakaatuh,\n\n`+
    `Macallin ${teacherName}, mahadsanid dadaalka joogtada ah ee aad u geli fasalka. Waxaan kuu soo dirayaa natiijadii taftiishka maamulka ee ugu dambeeyay, oo ah wax lagu isla horumarinayo, ma aha wax lagugu dhaliilayo:\n\n${blocks}\n`+
    `📊 Guud ahaan: ${pct}% ayaa la gaadhay — mahadsanid wixii aad horeba u fulisay, waxaanan ku rajaynaynaa inaad sii xoojiso qodobbada kale.\n\n`+
    `Mahadsanid wanaaggaaga iyo dadaalkaaga, Alle ha ku barakeeyo. Wixii su'aal ama faahfaahin dheeraad ah, nala soo xiriir.\n— Maamulka AL-XIKMA SCHOOL`;
}
function populateInspectMonthFilter(){
  const sel = document.getElementById('insp-month-filter');
  if(!sel) return;
  const months = new Set();
  Object.values(INSPECTIONS).forEach(batches=>{
    Object.values(batches || {}).forEach(insp=>{
      const d = new Date(insp.date);
      months.add(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'));
    });
  });
  const sorted = Array.from(months).sort().reverse();
  const prevVal = sel.value;
  sel.innerHTML = '<option value="">📚 Dhammaan Bilaha</option>' + sorted.map(ym=>{
    const [y,m] = ym.split('-').map(Number);
    const label = new Date(y, m-1, 1).toLocaleDateString('so-SO', {month:'long', year:'numeric'});
    return `<option value="${ym}">${label}</option>`;
  }).join('');
  if(prevVal && sorted.includes(prevVal)) sel.value = prevVal;
  else if(sorted.length) sel.value = sorted[0];
  else sel.value = '';
}
function onInspectMonthChange(){
  renderInspectionRanking();
  renderInspectionMatrix();
  renderInspectionHistory();
}
function getInspectMonthFilter(){
  const sel = document.getElementById('insp-month-filter');
  return sel ? sel.value : '';
}
function inspectionInMonth(insp, ym){
  if(!ym) return true;
  const d = new Date(insp.date);
  return (d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')) === ym;
}
function renderInspectionRanking(){
  const el = document.getElementById('insp-ranking');
  if(!el) return;
  const monthFilter = getInspectMonthFilter();
  const stats = {}; // teacherId -> {name, score, total, count, byFasal:{fasal:{score,total}}}
  Object.entries(INSPECTIONS).forEach(([teacherId, batches])=>{
    Object.values(batches || {}).forEach(insp=>{
      if(!inspectionInMonth(insp, monthFilter)) return;
      if(!stats[teacherId]) stats[teacherId] = {name: insp.teacherName, score:0, total:0, count:0, byFasal:{}};
      stats[teacherId].count++;
      const fasal = insp.fasal || '';
      if(fasal && !stats[teacherId].byFasal[fasal]) stats[teacherId].byFasal[fasal] = {score:0, total:0};
      (insp.subjects || []).forEach(s=>{
        INSPECTION_ITEMS.forEach(it=>{
          stats[teacherId].total++;
          const w = RATING_WEIGHTS[s.items && s.items[it.id]] || 0;
          stats[teacherId].score += w;
          if(fasal){
            stats[teacherId].byFasal[fasal].total++;
            stats[teacherId].byFasal[fasal].score += w;
          }
        });
      });
    });
  });
  const list = Object.values(stats)
    .map(s=>{
      const fasalPcts = Object.entries(s.byFasal).map(([fasal,f])=>({fasal, pct: f.total ? Math.round(f.score/f.total*100) : 0}));
      fasalPcts.sort((a,b)=> b.pct - a.pct);
      return {...s, pct: s.total ? Math.round(s.score/s.total*100) : 0,
        best: fasalPcts[0], worst: fasalPcts.length>1 ? fasalPcts[fasalPcts.length-1] : null};
    })
    .sort((a,b)=> b.pct - a.pct);
  if(list.length===0){ el.innerHTML = '<p class="muted">Weli lama taftiishin macalin.</p>'; return; }
  const medals = ['🥇','🥈','🥉'];
  el.innerHTML = list.map((s,idx)=>`
    <div class="student-row">
      <div style="flex:1;">
        <div class="student-name">${medals[idx] || ('#'+(idx+1))} ${escapeHtml(s.name)}</div>
        <div class="student-meta">${s.count} taftiish · ${Math.round(s.score*10)/10}/${s.total} qodob (culayska qiimaha)</div>
        ${s.best ? `<div class="student-meta">🏆 Ugu fiican: ${escapeHtml(s.best.fasal)} (${s.best.pct}%)${s.worst ? ` · 🌱 Xoojin u baahan: ${escapeHtml(s.worst.fasal)} (${s.worst.pct}%)` : ''}</div>` : ''}
      </div>
      <div style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:1.05rem;">${s.pct}%</div>
    </div>`).join('');
}
function renderInspectionMatrix(){
  const el = document.getElementById('insp-matrix');
  if(!el) return;
  if(INSPECTION_ITEMS.length===0){ el.innerHTML = '<p class="muted">Weli qodob lama darin.</p>'; return; }
  const monthFilter = getInspectMonthFilter();

  // teacherId -> {name, perItem:{itemId:{score,total}}, score, total}
  const stats = {};
  Object.entries(INSPECTIONS).forEach(([teacherId, batches])=>{
    Object.values(batches || {}).forEach(insp=>{
      if(!inspectionInMonth(insp, monthFilter)) return;
      if(!stats[teacherId]){
        stats[teacherId] = {name: insp.teacherName, score:0, total:0, perItem:{}};
        INSPECTION_ITEMS.forEach(it=>{ stats[teacherId].perItem[it.id] = {score:0, total:0}; });
      }
      (insp.subjects || []).forEach(s=>{
        INSPECTION_ITEMS.forEach(it=>{
          if(!stats[teacherId].perItem[it.id]) stats[teacherId].perItem[it.id] = {score:0, total:0};
          const w = RATING_WEIGHTS[s.items && s.items[it.id]] || 0;
          stats[teacherId].perItem[it.id].score += w;
          stats[teacherId].perItem[it.id].total++;
          stats[teacherId].score += w;
          stats[teacherId].total++;
        });
      });
    });
  });

  const rows = Object.values(stats).sort((a,b)=> (b.total? b.score/b.total:0) - (a.total? a.score/a.total:0));
  if(rows.length===0){ el.innerHTML = '<p class="muted">Weli lama taftiishin macalin.</p>'; return; }

  const pct = (score,total)=> total ? Math.round(score/total*100) : 0;
  const cellColor = p => p>=80 ? '#1f6d3d' : p>=50 ? '#b8860b' : '#b32020';

  let html = `<table style="width:100%;border-collapse:collapse;font-size:0.85rem;min-width:${560+INSPECTION_ITEMS.length*90}px;">`;
  html += `<thead><tr style="background:#f4f4f0;">
    <th style="text-align:left;padding:8px;border:1px solid #ddd;position:sticky;left:0;background:#f4f4f0;">Macalinka</th>
    ${INSPECTION_ITEMS.map(it=>`<th style="padding:8px;border:1px solid #ddd;font-size:0.78rem;">${escapeHtml(it.label)}</th>`).join('')}
    <th style="padding:8px;border:1px solid #ddd;">Total</th>
    <th style="padding:8px;border:1px solid #ddd;">Celcelis</th>
  </tr></thead><tbody>`;

  rows.forEach(r=>{
    const overallPct = pct(r.score, r.total);
    html += `<tr>
      <td style="padding:8px;border:1px solid #ddd;font-weight:600;position:sticky;left:0;background:#fff;">${escapeHtml(r.name)}</td>
      ${INSPECTION_ITEMS.map(it=>{
        const cell = r.perItem[it.id] || {score:0,total:0};
        const p = pct(cell.score, cell.total);
        return `<td style="padding:8px;border:1px solid #ddd;text-align:center;color:${cellColor(p)};font-weight:600;">${cell.total ? p+'%' : '—'}</td>`;
      }).join('')}
      <td style="padding:8px;border:1px solid #ddd;text-align:center;font-family:'JetBrains Mono',monospace;">${Math.round(r.score*10)/10}/${r.total}</td>
      <td style="padding:8px;border:1px solid #ddd;text-align:center;font-weight:700;color:${cellColor(overallPct)};">${overallPct}%</td>
    </tr>`;
  });

  // Average row across all teachers per item
  html += `<tr style="background:#f4f4f0;font-weight:700;">
    <td style="padding:8px;border:1px solid #ddd;position:sticky;left:0;background:#f4f4f0;">Celceliska Guud</td>
    ${INSPECTION_ITEMS.map(it=>{
      let s=0,t=0;
      rows.forEach(r=>{ const c=r.perItem[it.id]||{score:0,total:0}; s+=c.score; t+=c.total; });
      const p = pct(s,t);
      return `<td style="padding:8px;border:1px solid #ddd;text-align:center;color:${cellColor(p)};">${t?p+'%':'—'}</td>`;
    }).join('')}
    <td style="padding:8px;border:1px solid #ddd;"></td>
    <td style="padding:8px;border:1px solid #ddd;text-align:center;color:${cellColor(pct(rows.reduce((a,r)=>a+r.score,0), rows.reduce((a,r)=>a+r.total,0)))};">${pct(rows.reduce((a,r)=>a+r.score,0), rows.reduce((a,r)=>a+r.total,0))}%</td>
  </tr>`;

  html += `</tbody></table>`;
  el.innerHTML = html;
}
function renderInspectionHistory(){
  const el = document.getElementById('insp-history');
  if(!el) return;
  const monthFilter = getInspectMonthFilter();
  const entries = [];
  Object.entries(INSPECTIONS).forEach(([teacherId, batches])=>{
    Object.entries(batches || {}).forEach(([key, insp])=>{ if(inspectionInMonth(insp, monthFilter)) entries.push({teacherId, key, ...insp}); });
  });
  entries.sort((a,b)=> b.date - a.date);
  if(entries.length===0){ el.innerHTML = '<p class="muted">Weli lama taftiishin macalin.</p>'; return; }
  el.innerHTML = entries.map(e=>{
    const uid = `${e.teacherId}_${e.key}`;
    let totalItems = 0, totalScore = 0;
    (e.subjects || []).forEach(s=>{
      INSPECTION_ITEMS.forEach(it=>{ totalItems++; totalScore += RATING_WEIGHTS[s.items && s.items[it.id]] || 0; });
    });
    const pct = totalItems ? Math.round(totalScore/totalItems*100) : 0;
    const subjectsHtml = (e.subjects || []).map(s=>{
      return `<div style="margin-top:8px;">
        <b>${escapeHtml(s.maadada)}</b>
        <ul class="detail-list">
          ${INSPECTION_ITEMS.map(it=>{
            const rating = (s.items && s.items[it.id]) || '';
            return `<li>${RATING_LABELS[rating] || '—'} ${escapeHtml(it.label)}</li>`;
          }).join('')}
        </ul>
        ${s.notes ? `<p class="muted" style="margin:4px 0;">📝 ${escapeHtml(s.notes)}</p>` : ''}
      </div>`;
    }).join('');
    const teacherPhone = (TEACHERS[e.teacherId] && TEACHERS[e.teacherId].phone) ? String(TEACHERS[e.teacherId].phone).replace(/[^0-9+]/g,'') : '';
    const waMsg = encodeURIComponent(buildTeacherInspectionMessage(e.teacherName, e.subjects || []));
    const waBtn = teacherPhone
      ? `<a href="https://wa.me/${teacherPhone}?text=${waMsg}" target="_blank"><button class="btn-whatsapp btn-sm">💬 U dir Macalinka</button></a>`
      : `<span class="muted">Telefoonka macallinka lama gelin — ku dar tabka "Macallimiinta"</span>`;
    return `<div class="flagged-item">
      <div class="flagged-head" style="cursor:pointer;" onclick="toggleInspectionEntry('${uid}')">
        <div>
          <span class="flagged-name">${escapeHtml(e.teacherName)}</span>
          ${e.fasal ? `<span class="pill">${escapeHtml(e.fasal)}</span>` : ''}
          <span class="pill">${pct}%</span>
        </div>
        <span class="muted">${new Date(e.date).toLocaleString('so')} ▾</span>
      </div>
      <div id="insp-entry-${uid}" class="hidden" style="margin-top:8px;">
        ${subjectsHtml}
        <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;">
          ${waBtn}
          <button class="btn-danger btn-sm" onclick="event.stopPropagation(); deleteInspection('${e.teacherId}','${e.key}')">🗑️ Tirtir</button>
        </div>
      </div>
    </div>`;
  }).join('');
}
function toggleInspectionEntry(uid){
  const el = document.getElementById('insp-entry-'+uid);
  if(el) el.classList.toggle('hidden');
}
function deleteInspection(teacherId, key){
  if(!confirm('Ma hubtaa inaad tirtirto taftiishkan?')) return;
  db.child('inspections/'+teacherId+'/'+key).remove().then(()=>toast('Waa la tirtiray.'));
}

