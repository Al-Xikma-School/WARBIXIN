      ${INSPECTION_ITEMS.map(it=>`
        <div class="rating-item">
          <div class="rating-item-label">${escapeHtml(it.label)}</div>
          <div class="rating-item-source">${it.source==='buug' ? '📓 Buugta' : '🗣️ Su\'aal Arday'}</div>
          <input type="hidden" id="insp-${idx}-${it.id}" value="">
          <div class="rating-btns">
            <div class="rating-btn rb-good" id="btn-${idx}-${it.id}-good" onclick="setRating(${idx},'${it.id}','good')">😊 Fiican</div>
            <div class="rating-btn rb-average" id="btn-${idx}-${it.id}-average" onclick="setRating(${idx},'${it.id}','average')">😐 Dhexdhexaad</div>
            <div class="rating-btn rb-weak" id="btn-${idx}-${it.id}-weak" onclick="setRating(${idx},'${it.id}','weak')">🌱 U baahan Xoojin</div>
