document.getElementById('excel-file') && document.getElementById('excel-file').addEventListener('change', function(e){
  const file = e.target.files[0];
  if(!file) return;
  const status = document.getElementById('excel-status');
  status.textContent = 'Waa la akhrinayaa...';
  const reader = new FileReader();
  reader.onload = function(evt){
    try{
      const wb = XLSX.read(evt.target.result, {type:'binary'});
      const sheet = wb.Sheets[wb.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(sheet, {header:1});
      const updates = {};
      let count=0;
      rows.forEach((row, idx)=>{
        if(idx===0) return; // skip header row
        const [name, phone1, phone2, fasal, section] = row;
        if(!name) return;
        const key = db.child('students').push().key;
        updates[key] = {
          name: String(name).trim(),
          phone1: normalizePhone(phone1),
          phone2: normalizePhone(phone2),
          fasal: fasal ? String(fasal).trim() : '',
          section: section ? String(section).trim() : ''
        };
        count++;
      });
      db.child('students').update(updates).then(()=>{
        status.textContent = `${count} arday ayaa si guul leh loo soo geliyay.`;
        toast('Excel waa la soo dhigay!');
      });
    }catch(err){
      status.textContent = 'Khalad ayaa dhacay: ' + err.message;
    }
  };
  reader.readAsBinaryString(file);
});

