  CURRENT_DEPT = dept;
  db = firebase.database().ref('ardaydaHoosaysa/' + dept); // namespaced per department so Iskuulka & Quraanka never mix
  STUDENTS = {}; TEACHERS = {}; SUBMISSIONS = {}; QURAN_SUBMISSIONS = {}; currentTeacher = null; currentBatch = null; currentQuranBatch = null;
  if(window.QoraalMobileApp) QoraalMobileApp.reset();
