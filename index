// One-time migration: data created before the department split lived directly under
// ardaydaHoosaysa/{students,teachers,submissions,config}. Move it into ardaydaHoosaysa/iskuul/
// exactly once (guarded by a _migrated flag) so nothing entered earlier gets lost or hidden.
function migrateLegacyIskuulData(){
  const rootRef = firebase.database().ref('ardaydaHoosaysa');
  rootRef.child('iskuul/_migrated').once('value', flagSnap=>{
    if(flagSnap.exists()) return; // already migrated, do nothing
    rootRef.once('value', rootSnap=>{
      const val = rootSnap.val() || {};
      const legacy = {};
      ['students','teachers','submissions','config'].forEach(k=>{
        if(val[k]) legacy['iskuul/'+k] = val[k];
      });
      legacy['iskuul/_migrated'] = true;
      rootRef.update(legacy).then(()=>{
        if(Object.keys(legacy).length > 1) toast('✅ Xogtii hore (macallimiinta, ardayda, warbixinnadii) waa dib loo soo celiyay.');
      });
    });
  });
}
function backToDeptSelect(){
  if(db){ db.child('students').off(); db.child('teachers').off(); db.child('submissions').off(); db.child('quranWeekly').off(); }
  db = null; CURRENT_DEPT = null; currentTeacher = null; currentBatch = null; currentQuranBatch = null;
