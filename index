  const toVal = document.getElementById('dash-date-to') ? document.getElementById('dash-date-to').value : '';
  const fromTs = fromVal ? new Date(fromVal+'T00:00:00').getTime() : null;
  const toTs = toVal ? new Date(toVal+'T23:59:59').getTime() : null;

  const agg = {}; // studentId -> {name, teachers:Set, details:[]}
  Object.entries(SUBMISSIONS).forEach(([teacherId, batches])=>{
    Object.values(batches || {}).forEach(b=>{
      if(fromTs && b.submittedAt < fromTs) return;
      if(toTs && b.submittedAt > toTs) return;
      Object.entries(b.students || {}).forEach(([sid, info])=>{
        if(!agg[sid]) agg[sid] = {name: info.name, teacherSet: new Set(), details: []};
        agg[sid].teacherSet.add(teacherId);
        agg[sid].details.push({teacherName: b.teacherName, maadada: b.maadada, cilad: info.cilad, fasal: b.fasal, section: b.section, submittedAt: b.submittedAt});
      });
    });
  });
  const list = Object.entries(agg).sort((a,b)=> b[1].teacherSet.size - a[1].teacherSet.size);
