function renderDailyTeacherStatus(){
  const el = document.getElementById('daily-status');
  const startInp = document.getElementById('daily-date-start');
  const endInp = document.getElementById('daily-date-end');
  if(!el || !startInp || !endInp) return;
  const startVal = startInp.value, endVal = endInp.value;
  if(!startVal || !endVal){ el.innerHTML = '<p class="muted">Dooro taariikhda bilowga iyo dhamaadka.</p>'; return; }
  const rangeStart = new Date(startVal+'T00:00:00').getTime();
  const rangeEnd = new Date(endVal+'T00:00:00').getTime() + 24*60*60*1000;
  if(rangeEnd <= rangeStart){ el.innerHTML = '<p class="muted">Taariikhda dhamaadku waa in ay ka dambaysaa ama la mid tahay tan bilowga.</p>'; return; }
  const counts = {}; // teacherId -> count
  Object.entries(SUBMISSIONS).forEach(([teacherId, batches])=>{
    Object.values(batches || {}).forEach(b=>{
      if(b.submittedAt >= rangeStart && b.submittedAt < rangeEnd){
        counts[teacherId] = (counts[teacherId] || 0) + Object.keys(b.students||{}).length;
      }
    });
  });
  const rows = Object.entries(TEACHERS).map(([id,t])=>({name:t.name, count: counts[id] || 0}))
    .sort((a,b)=> b.count - a.count);
  if(rows.length===0){ el.innerHTML = '<p class="muted">Weli macalin lama darin.</p>'; return; }
  const submitted = rows.filter(r=>r.count>0);
  const notSubmitted = rows.filter(r=>r.count===0);
  el.innerHTML = `
    <p class="muted" style="margin-bottom:8px;">✅ ${submitted.length} macalin ayaa wax soo gudbiyay · ⚠️ ${notSubmitted.length} macalin ma soo gudbin waxba xilligan</p>
