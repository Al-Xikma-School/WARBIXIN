  let viewer = `<p class="muted">Nooca faylkan lama muujin karo halkan — riix si aad u soo dejiso.</p>`;
  if(isPdf) viewer = `<iframe src="${book.fileData}" style="width:100%;height:70vh;border:1px solid #ddd;border-radius:10px;"></iframe>`;
  else if(isImg) viewer = `<img src="${book.fileData}" style="max-width:100%;border-radius:10px;box-shadow:0 4px 14px rgba(0,0,0,0.15);">`;
  return `
    <div class="book-content">
      <div class="book-header">
        <span class="book-header-icon">${book.icon || '📄'}</span>
        <h2>${escapeHtml(book.title)}</h2>
