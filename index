      notebooks: [{ id:nbId, name:'Shaqada', color:NB_COLORS[0] }],
      sections: [{ id:secId, notebookId:nbId, name:'Guud' }],
      pages: [{ id:pgId, sectionId:secId, title:'Ku soo dhawoow', content:'Halkan waxaad ku qori kartaa fikradahaaga, qorshayaashaada, iyo xusuus-qorka maalinlaha ah.\n\nTaabo "+" si aad u samaysato bog kale.', updatedAt: now() }]
    };
  }

  function loadState(){
    // Backed by the same Firebase ref as the rest of the admin app (db is
    // department-scoped), instead of window.storage, so notes are shared
    // across admins/devices the same way students/teachers/inspections are.
    return new Promise(resolve=>{
      db.child('qoraal').once('value', snap=>{
        const val = snap.val();
        if(val){
          state = val;
        } else {
          state = defaultState();
          persist();
        }
        resolve();
      });
    });
  }

  function persist(){
    return db.child('qoraal').set(state).catch(e=>console.error('Storage error', e));
  }
  function schedulePersist(){
    clearTimeout(saveTimer);
    saveTimer = setTimeout(persist, 400);
  }

  function fmtDate(ts){
    const d = new Date(ts);
    return d.toLocaleDateString('so-SO', { day:'numeric', month:'short' }) + ' · ' + d.toLocaleTimeString('so-SO', { hour:'2-digit', minute:'2-digit' });
  }

  function sectionsOf(nbId){ return state.sections.filter(s => s.notebookId === nbId); }
  function pagesOf(secId){ return state.pages.filter(p => p.sectionId === secId).sort((a,b)=>b.updatedAt-a.updatedAt); }

  function ensureSelection(){
    if(!state.notebooks.find(n=>n.id===selected.notebookId)){
      selected.notebookId = state.notebooks[0] ? state.notebooks[0].id : null;
    }
    const secs = selected.notebookId ? sectionsOf(selected.notebookId) : [];
    if(!secs.find(s=>s.id===selected.sectionId)){
      selected.sectionId = secs[0] ? secs[0].id : null;
    }
  }

  function escapeHtml(s){
    return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function render(){
    ensureSelection();
    renderBottomBar();
    renderTop();
    renderPageList();
  }

  function renderBottomBar(){
    const wrap = document.getElementById('nbTabs');
    wrap.innerHTML = '';
    state.notebooks.forEach(nb=>{
      const btn = document.createElement('button');
      btn.className = 'nb-tab' + (nb.id===selected.notebookId ? ' active':'');
      btn.style.background = nb.color;
      btn.textContent = nb.name.trim().charAt(0).toUpperCase();
      btn.title = nb.name;
      btn.onclick = ()=>{
        selected.notebookId = nb.id;
        selected.sectionId = null;
        render();
      };
      wrap.appendChild(btn);
    });
    const add = document.createElement('button');
    add.className = 'nb-add';
    add.textContent = '+';
    add.onclick = addNotebook;
    wrap.appendChild(add);
  }

  function renderTop(){
    const nb = state.notebooks.find(n=>n.id===selected.notebookId);
    document.getElementById('nbTitle').textContent = nb ? nb.name : 'Ma jiro buug';
    const badge = document.getElementById('nbBadge');
    if(nb){ badge.style.background = nb.color; badge.textContent = nb.name.charAt(0).toUpperCase(); }

    const secs = nb ? sectionsOf(nb.id) : [];
    const row = document.getElementById('sectionRow');
    row.innerHTML = '';
    secs.forEach(sec=>{
      const pill = document.createElement('button');
      pill.className = 'sec-pill' + (sec.id===selected.sectionId ? ' active':'');
      pill.textContent = sec.name;
      pill.onclick = ()=>{ selected.sectionId = sec.id; render(); };
      row.appendChild(pill);
    });
    const addSec = document.createElement('button');
    addSec.className = 'sec-pill add';
    addSec.textContent = '+ Qaybo';
    addSec.onclick = addSection;
    row.appendChild(addSec);
  }

  function renderPageList(){
    const list = document.getElementById('pageList');
    list.innerHTML = '';
    if(!selected.sectionId){
      list.innerHTML = '<div class="empty-note"><span class="glyph">Qoraal</span>Samayso qaybo si aad bogag u aragto.</div>';
      return;
    }
    const pages = pagesOf(selected.sectionId);
    if(pages.length===0){
      list.innerHTML = '<div class="empty-note"><span class="glyph">Qoraal</span>Weli bog ma jiro.<br>Taabo "+" si aad u bilowdo.</div>';
      return;
    }
    pages.forEach(p=>{
      const item = document.createElement('div');
      item.className = 'page-item';
      const previewText = (p.content||'').replace(/<[^>]*>/g,' ');
      const preview = previewText.replace(/\s+/g,' ').trim().slice(0,70);
      item.innerHTML = `<div class="page-item-title">${escapeHtml(p.title || 'Bog aan cinwaan lahayn')}</div>
                         <div class="page-item-meta">${fmtDate(p.updatedAt)}${preview? ' — '+escapeHtml(preview):''}</div>`;
      item.onclick = ()=> openEditor(p.id);
      list.appendChild(item);
    });
  }

  function openEditor(pageId){
    selected.pageId = pageId;
    const page = state.pages.find(p=>p.id===pageId);
    if(!page) return;
    document.getElementById('titleInput').value = page.title || '';
    document.getElementById('bodyInput').innerHTML = page.content || '';
    document.getElementById('editorDate').textContent = fmtDate(page.updatedAt);
    document.body.classList.add('editor-open');
  }

  function closeEditor(){
    document.body.classList.remove('editor-open');
    selected.pageId = null;
    renderPageList();
  }

  function currentPage(){ return state.pages.find(p=>p.id===selected.pageId); }

  document.getElementById('titleInput').addEventListener('input', (e)=>{
    const page = currentPage(); if(!page) return;
    page.title = e.target.value;
    page.updatedAt = now();
    document.getElementById('editorDate').textContent = fmtDate(page.updatedAt);
    schedulePersist();
  });
  document.getElementById('bodyInput').addEventListener('input', (e)=>{
    const page = currentPage(); if(!page) return;
    page.content = e.target.innerHTML;
    page.updatedAt = now();
    document.getElementById('editorDate').textContent = fmtDate(page.updatedAt);
    schedulePersist();
  });

  // Mobile browsers can lose the text cursor position the instant a toolbar
  // button is tapped (focus moves away from the note body). We continuously
  // remember the last real cursor position inside the note so formatting
  // commands apply exactly where the person was typing, not somewhere random.
  let savedRange = null;
  const bodyInputEl = document.getElementById('bodyInput');
  function saveSelection(){
    const sel = window.getSelection();
    if(sel && sel.rangeCount > 0){
      const range = sel.getRangeAt(0);
      if(bodyInputEl.contains(range.commonAncestorContainer)){
        savedRange = range.cloneRange();
      }
    }
  }
  ['keyup','mouseup','touchend','input'].forEach(evt=>{
    bodyInputEl.addEventListener(evt, saveSelection);
  });

  function restoreSelection(){
    bodyInputEl.focus();
    const sel = window.getSelection();
    sel.removeAllRanges();
    const range = document.createRange();
    if(savedRange && bodyInputEl.contains(savedRange.startContainer)){
      try{ sel.addRange(savedRange); return; }catch(e){ /* fall through */ }
    }
    range.selectNodeContents(bodyInputEl);
    range.collapse(false);
    sel.addRange(range);
  }

  document.querySelectorAll('.fmt-btn').forEach(btn=>{
    btn.addEventListener('pointerdown', (e)=> e.preventDefault());
    btn.addEventListener('mousedown', (e)=> e.preventDefault());
    btn.addEventListener('click', ()=>{
      const cmd = btn.getAttribute('data-cmd');
      restoreSelection();
      if(cmd === 'checklist'){
        document.execCommand('insertUnorderedList', false, null);
        const sel = window.getSelection();
        if(sel.rangeCount){
          let node = sel.getRangeAt(0).startContainer;
          while(node && node !== bodyInputEl){
            if(node.nodeType === 1 && node.tagName === 'UL'){
              node.classList.add('checklist');
              break;
            }
            node = node.parentNode;
          }
        }
      } else {
        document.execCommand(cmd, false, null);
      }
      saveSelection();
      const page = currentPage();
      if(page){
        page.content = bodyInputEl.innerHTML;
        page.updatedAt = now();
        schedulePersist();
      }
    });
  });

  // Tap the checkbox area of a checklist item to mark it done/undone.
  bodyInputEl.addEventListener('click', (e)=>{
    const li = e.target.closest('li');
    if(!li || !li.parentElement || !li.parentElement.classList.contains('checklist')) return;
    const rect = li.getBoundingClientRect();
    if(e.clientX - rect.left <= 28){
      e.preventDefault();
      li.classList.toggle('checked');
      const page = currentPage();
      if(page){
        page.content = bodyInputEl.innerHTML;
        page.updatedAt = now();
        schedulePersist();
      }
    }
  });

  document.getElementById('backBtn').onclick = closeEditor;
  document.getElementById('deletePageBtn').onclick = ()=>{
    const page = currentPage(); if(!page) return;
    if(!confirm('Ma tirtirtaa bogga?')) return;
    state.pages = state.pages.filter(p=>p.id!==page.id);
    schedulePersist();
    closeEditor();
  };

  function addNotebook(){
    const name = prompt('Magaca buugga cusub:');
    if(!name) return;
    const color = NB_COLORS[state.notebooks.length % NB_COLORS.length];
    const nb = { id:uid(), name:name.trim(), color };
    state.notebooks.push(nb);
    const sec = { id:uid(), notebookId:nb.id, name:'Guud' };
    state.sections.push(sec);
    selected.notebookId = nb.id;
    selected.sectionId = sec.id;
    schedulePersist();
    render();
  }

  function addSection(){
    if(!selected.notebookId) return;
    const name = prompt('Magaca qaybta cusub:');
    if(!name) return;
    const sec = { id:uid(), notebookId:selected.notebookId, name:name.trim() };
    state.sections.push(sec);
    selected.sectionId = sec.id;
    schedulePersist();
    render();
  }

  function addPage(){
    if(!selected.sectionId){
      alert('Marka hore samayso ama dooro qaybo.');
      return;
    }
    const pg = { id:uid(), sectionId:selected.sectionId, title:'', content:'', updatedAt: now() };
    state.pages.push(pg);
    schedulePersist();
    renderPageList();
    openEditor(pg.id);
    setTimeout(()=>{ document.getElementById('titleInput').focus(); }, 250);
  }
  document.getElementById('addPageBtn').onclick = addPage;

  let qoraalInited = false;
  window.QoraalMobileApp = {
    init: async function(){
      if(qoraalInited) return;
      qoraalInited = true;
      await loadState();
      render();
    },
    reset: function(){
      qoraalInited = false;
      state = null;
      selected = { notebookId:null, sectionId:null, pageId:null };
    }
  };
})();

// ---------- Settings: Inspection Items ----------
function renderInspectionItemsSettings(){
  const el = document.getElementById('inspection-items-settings');
  if(!el) return;
  if(INSPECTION_ITEMS.length===0){ el.innerHTML = '<p class="muted">Weli qodob lama darin.</p>'; return; }
  el.innerHTML = INSPECTION_ITEMS.map(it=>`
    <div class="insp-item-row">
      <input type="text" value="${escapeHtml(it.label)}" style="border:1px solid #ddd7c4;border-radius:8px;padding:7px 10px;"
        onchange="updateInspectionItem('${it.id}','label', this.value)">
      <select onchange="updateInspectionItem('${it.id}','source', this.value)">
        <option value="buug" ${it.source==='buug' ? 'selected' : ''}>📓 Buugta</option>
        <option value="arday" ${it.source==='arday' ? 'selected' : ''}>🗣️ Su'aal Arday</option>
      </select>
      <button class="btn-danger btn-sm" onclick="deleteInspectionItem('${it.id}')">🗑️</button>
    </div>`).join('');
}
function addInspectionItem(){
  const labelInp = document.getElementById('new-item-label');
  const sourceSel = document.getElementById('new-item-source');
  const label = labelInp.value.trim();
  if(!label){ toast('Fadlan geli cinwaanka qodobka.'); return; }
  const order = INSPECTION_ITEMS.length;
  const key = db.child('inspectionItems').push().key;
  db.child('inspectionItems/'+key).set({label, source: sourceSel.value, order}).then(()=>{
    labelInp.value = '';
    toast('Qodobka waa la daray.');
  });
}
function updateInspectionItem(id, field, value){
  db.child('inspectionItems/'+id+'/'+field).set(field==='label' ? value.trim() : value);
}
function deleteInspectionItem(id){
  if(!confirm('Ma hubtaa inaad tirtirto qodobkan? Taftiishyadii hore ee isticmaalay qodobkan way sii jirayaan sida ay ahaayeen.')) return;
  db.child('inspectionItems/'+id).remove().then(()=>toast('Qodobka waa la tirtiray.'));
}

// ---------- Settings: Books Library ----------
function uploadNewBook(){
  const titleInp = document.getElementById('new-book-title');
  const deptSel = document.getElementById('new-book-dept');
  const iconInp = document.getElementById('new-book-icon');
  const fileInp = document.getElementById('new-book-file');
  const title = titleInp.value.trim();
  const file = fileInp.files[0];
  if(!title){ toast('Fadlan geli cinwaanka buugga.'); return; }
  if(!file){ toast('Fadlan dooro fayl aad soo geli rabto.'); return; }
  if(file.size > 5*1024*1024){ toast('Faylku waa ka weyn yahay 5MB — dooro fayl ka yar.'); return; }
  const reader = new FileReader();
  reader.onload = function(){
    const key = booksLibRef.push().key;
    booksLibRef.child(key).set({
      title, subtitle:'', icon: iconInp.value.trim() || '📄',
      dept: deptSel.value, kind:'upload',
      fileName: file.name, fileType: file.type, fileData: reader.result
    }).then(()=>{
      titleInp.value=''; iconInp.value=''; fileInp.value='';
      toast('✅ Buugga waa la soo geliyay.');
    }).catch(()=> toast('Khalad ayaa dhacay — faylku waa ka weyn yahay xadka la ogolyahay.'));
  };
  reader.readAsDataURL(file);
}
function renderBooksSettingsList(){
  const el = document.getElementById('books-settings-list');
  if(!el) return;
  const entries = Object.entries(BOOKS_LIBRARY).filter(([id,b])=> b.dept===CURRENT_DEPT);
  if(entries.length===0){ el.innerHTML = '<p class="muted">Weli buug looma soo gelin qaybtan.</p>'; return; }
  el.innerHTML = entries.map(([id,b])=>`
    <div class="student-row">
      <div style="flex:1;">
        <div class="student-name">${b.icon || '📄'} ${escapeHtml(b.title)}</div>
        <div class="student-meta">${b.dept==='iskuul' ? '🏫 Qaybta Iskuulka' : '📖 Qaybta Qur\u2019aanka'}${b.kind==='builtin' ? ' · Buug Aasaasi ah' : ''}</div>
      </div>
      <button class="btn-danger btn-sm" onclick="deleteBook('${id}')">🗑️ Tirtir</button>
    </div>`).join('');
}
function deleteBook(id){
  if(!confirm('Ma hubtaa inaad tirtirto buuggan? Macallimiinta loo furay mar dambe ma heli doonaan.')) return;
  booksLibRef.child(id).remove().then(()=>toast('Buugga waa la tirtiray.'));
}

// ---------- Utils ----------
function escapeHtml(str){
  return String(str==null?'':str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
