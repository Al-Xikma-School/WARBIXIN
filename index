    if(!document.getElementById('view-admin').classList.contains('hidden')) renderTeacherList();
    if(currentTeacher && !document.getElementById('view-teacher-select').classList.contains('hidden') && !document.getElementById('t-tab-books').classList.contains('hidden')) renderTeacherBooksList();
  });
  db.child('config/adminPin').once('value', snap=>{ if(!snap.exists()) db.child('config/adminPin').set('1234'); });
  db.child('inspectionItems').once('value', snap=>{
    if(!snap.exists()){
      const seed = {};
      DEFAULT_INSPECTION_ITEMS.forEach((it,order)=>{
        const key = db.child('inspectionItems').push().key;
        seed[key] = {label: it.label, source: it.source, order};
      });
      db.child('inspectionItems').set(seed);
    }
  });
  db.child('inspectionItems').on('value', snap=>{
    const val = snap.val() || {};
    INSPECTION_ITEMS = Object.entries(val)
      .map(([id,it])=>({id, label:it.label, source:it.source, order: it.order||0}))
      .sort((a,b)=> a.order - b.order);
    if(!document.getElementById('view-admin').classList.contains('hidden')) renderInspectionItemsSettings();
  });
}

