function exportDashboardPDF(){
  const fromVal = document.getElementById('dash-date-from') ? document.getElementById('dash-date-from').value : '';
  const toVal = document.getElementById('dash-date-to') ? document.getElementById('dash-date-to').value : '';
  const fromTs = fromVal ? new Date(fromVal+'T00:00:00').getTime() : null;
  const toTs = toVal ? new Date(toVal+'T23:59:59').getTime() : null;

  const agg = {}; // studentId -> {name, teacherSet:Set}
  Object.entries(SUBMISSIONS).forEach(([teacherId, batches])=>{
    Object.values(batches || {}).forEach(b=>{
      if(fromTs && b.submittedAt < fromTs) return;
      if(toTs && b.submittedAt > toTs) return;
      Object.entries(b.students || {}).forEach(([sid, info])=>{
        if(!agg[sid]) agg[sid] = {name: info.name, teacherSet: new Set()};
        agg[sid].teacherSet.add(teacherId);
      });
    });
  });

  const MIN_TEACHERS = 3;
  const list = Object.entries(agg)
    .filter(([sid, data]) => data.teacherSet.size >= MIN_TEACHERS)
    .sort((a,b) => b[1].teacherSet.size - a[1].teacherSet.size);

  if(list.length === 0){
    toast(`Ma jiro arday ay ${MIN_TEACHERS} macalin ama in ka badan isku raaceen hoosayntiisa.`);
    return;
  }

  if(!window.jspdf){ toast('PDF library-ga lama soo shubin. Fadlan hubi internet-ka.'); return; }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();

  const dateRangeStr = (fromVal || toVal) ? `${fromVal || '...'}  ilaa  ${toVal || '...'}` : 'Dhammaan taariikhaha';
  doc.setFontSize(13);
  doc.text('AL-XIKMA SCHOOL', 14, 15);
  doc.setFontSize(11);
  doc.text(`Liiska Ardayda ay ${MIN_TEACHERS}+ Macalin Isku Raaceen Hoosayntiisa`, 14, 22);
  doc.setFontSize(9);
  doc.text(`Taariikhda: ${dateRangeStr}`, 14, 28);

  const rows = list.map(([sid, data], idx) => {
    const student = STUDENTS[sid] || {};
    return [
      String(idx + 1),
      data.name || '',
      student.phone1 || '-',
      student.phone2 || '-',
      String(data.teacherSet.size)
    ];
  });

  doc.autoTable({
    startY: 34,
    head: [['#', 'Magaca Ardayga', 'Taleefonka 1', 'Taleefonka 2', 'Inta Macalin']],
    body: rows,
    styles: { fontSize: 10, cellPadding: 3 },
    headStyles: { fillColor: [31, 61, 46], textColor: [255, 255, 255] },
    columnStyles: { 0: { cellWidth: 10 }, 4: { cellWidth: 24, halign: 'center' } }
  });

  const stamp = fromVal || toVal ? `${fromVal||'dhamaan'}_${toVal||'dhamaan'}` : new Date().toISOString().slice(0,10);
  doc.save(`ardayda-hoosaysa-${stamp}.pdf`);
}
