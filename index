    const phone1 = student.phone1 ? student.phone1.replace(/[^0-9+]/g,'') : '';
    const phone2 = student.phone2 ? student.phone2.replace(/[^0-9+]/g,'') : '';
    const waText = encodeURIComponent(buildParentMessage(data.name, data.details));
    let waButtons = '';
    if(phone1 && phone2){
      waButtons = `
        <a href="https://wa.me/${phone1}?text=${waText}" target="_blank"><button class="btn-whatsapp btn-sm">💬 Waalidka 1</button></a>
        <a href="https://wa.me/${phone2}?text=${waText}" target="_blank"><button class="btn-whatsapp btn-sm">💬 Waalidka 2</button></a>`;
    } else if(phone1 || phone2){
