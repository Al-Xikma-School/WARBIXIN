function tallyMarks(n){
  let html = '<span class="tally">';
  let full = Math.floor(n/5), rem = n%5;
  for(let g=0; g<full; g++){
    for(let i=0;i<4;i++) html += '<i></i>';
    html += '<i class="cross"></i>';
    html += '<span style="width:6px;"></span>';
  }
  for(let i=0;i<rem;i++) html += '<i></i>';
  html += '</span>';
  return html;
}
