function startInspection(){
  const teacherId = document.getElementById('insp-teacher').value;
  const fasal = document.getElementById('insp-fasal').value;
  const m1 = document.getElementById('insp-maadada1').value.trim();
  const m2 = document.getElementById('insp-maadada2').value.trim();
  const m3 = document.getElementById('insp-maadada3').value.trim();
  if(!teacherId){ toast('Fadlan dooro macallinka.'); return; }
  if(!fasal){ toast('Fadlan dooro fasalka.'); return; }
  if(!m1){ toast('Fadlan geli ugu yaraan Maadada 1aad.'); return; }
  const maadooyinka = [m1, m2, m3].filter(m=>m);
  currentInspection = {teacherId, teacherName: TEACHERS[teacherId].name, fasal, maadooyinka};
  const area = document.getElementById('insp-form-area');
